<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MAR Caribe</title>
  <link rel="stylesheet" href="css/estilos.css">
</head>
<body>

<header>
  <h1>🏝️ MAR Caribe</h1>
  <p>Modelos locales independientes + Tabla</p>
</header>

<main>
  <div id="cargaModelos">
    <h2>Cargando modelos...</h2>
    <div class="barra"><div id="barraProgreso"></div></div>
    <p id="estadoCarga">Iniciando...</p>
    <div id="estadoModelos">
      <p id="estadoSSD">⏳ SSD MobileNet v2: Pendiente</p>
      <p id="estadoEfficient">⏳ EfficientDet-Lite0: Pendiente</p>
    </div>
    <!-- 🆗 10 BOTONES DE PRUEBA — DIFERENTES MÉTODOS DE CARGA -->
    <div style="margin:15px 0; padding:10px; background:#f0f0f0; border-radius:8px;">
      <p style="font-weight:bold; margin:0 0 10px 0;">🔧 Métodos de carga (si falla arriba, usa uno de estos):</p>
      <button id="btnMetodo1" style="margin:3px; padding:6px;">1. CDN tfjs-tflite oficial</button>
      <button id="btnMetodo2" style="margin:3px; padding:6px;">2. Carga dinámica con timeout</button>
      <button id="btnMetodo3" style="margin:3px; padding:6px;">3. Usar fetch + eval</button>
      <button id="btnMetodo4" style="margin:3px; padding:6px;">4. Versión específica alpha.9</button>
      <button id="btnMetodo5" style="margin:3px; padding:6px;">5. jsDelivr CDN alternativo</button>
      <button id="btnMetodo6" style="margin:3px; padding:6px;">6. Unpkg CDN</button>
      <button id="btnMetodo7" style="margin:3px; padding:6px;">7. Cargar TF.js desde local</button>
      <button id="btnMetodo8" style="margin:3px; padding:6px;">8. Esperar 10s + reintentar</button>
      <button id="btnMetodo9" style="margin:3px; padding:6px;">9. Sin librería — validar archivos</button>
      <button id="btnMetodo10" style="margin:3px; padding:6px;">10. Diagnóstico completo</button>
    </div>
    <div id="logsDepuracion" style="margin-top:10px; padding:10px; background:#1a1a1a; color:#0f0; font-family:monospace; font-size:11px; max-height:300px; overflow-y:auto; border-radius:6px;">
      <div>📋 Logs de depuración iniciados...</div>
    </div>
  </div>

  <div id="paso1" class="oculto">
    <h2>1. Elegir imagen</h2>
    <input type="file" id="archivoImagen" accept="image/*">
    <button id="btnElegir">📁 Elegir Imagen</button>
    <div id="vistaImagen" class="oculto">
      <img id="imagenPreview" alt="Imagen cargada">
      <div class="selectorModelo">
        <label id="labelSSD" class="desactivado">
          <input type="radio" name="modelo" value="ssd" disabled>
          SSD MobileNet v2
        </label>
        <label id="labelEfficient" class="desactivado">
          <input type="radio" name="modelo" value="efficient" disabled>
          EfficientDet-Lite0
        </label>
      </div>
      <button id="btnDetectar">🔍 Detectar con IA</button>
      <button id="btnAnalizarTabla">📐 Analizar como Tabla</button>
    </div>
  </div>

  <div id="paso2" class="oculto">
    <h2 id="tituloPaso2">Resultados</h2>
    <canvas id="lienzoDeteccion"></canvas>
    <div id="resultadosIA"></div>
    <button id="btnExtraerTabla">📊 Extraer como tabla</button>
    <button id="btnVolver">⬅️ Otra imagen</button>
  </div>

  <div id="paso3" class="oculto">
    <h2>3. Tabla extraída</h2>
    <div id="contenedorTabla"></div>
    <button id="btnCopiar">📋 Copiar</button>
    <button id="btnWhatsApp">💬 Enviar WhatsApp</button>
    <button id="btnNueva">🔄 Nueva imagen</button>
  </div>

  <div id="avisos"></div>
</main>

<!-- TensorFlow.js - CARGA PRIMERO -->
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js"></script>
<script>
// 🔍 LOG GLOBAL — CADA PASO QUEDA REGISTRADO
const logsDiv = document.getElementById('logsDepuracion');
const log = (texto, tipo = 'info') => {
  const hora = new Date().toLocaleTimeString();
  const colores = { info: '#0ff', ok: '#0f0', error: '#f55', warn: '#ff0' };
  const etiqueta = document.createElement('div');
  etiqueta.style.color = colores[tipo];
  etiqueta.textContent = `[${hora}] ${texto}`;
  logsDiv.appendChild(etiqueta);
  logsDiv.scrollTop = logsDiv.scrollHeight;
  console.log(`[${tipo.toUpperCase()}] ${texto}`);
};

log('✅ HTML cargado completamente', 'ok');
log('📍 Iniciando detección de entorno...', 'info');
log(`📍 User-Agent: ${navigator.userAgent.substring(0, 80)}...`, 'info');

// Verificar TF.js base
if (window.tf) {
  log(`✅ TensorFlow.js v${tf.version.tfjs} cargado`, 'ok');
} else {
  log('❌ TensorFlow.js NO se cargó — bloqueo de red/CDN', 'error');
}
</script>
<script src="js/app.js"></script>
</body>
</html>
